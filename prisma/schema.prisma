generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model jadwalSholat {
  id    Int    @id @default(autoincrement())
  time  String
  prayer String
}

model asmaulHusna {
  id      Int    @id @default(autoincrement())
  name    String
  meaning String
}

model doaHarian {
  id    Int    @id @default(autoincrement())
  title String
  text  String
}

model User {
  id       Int    @id @default(autoincrement())
  email    String @unique
  password String
  name     String?
}
